{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "America/Detroit",
  "gitAuthor": "Jake Robb <jakerobb@users.noreply.github.com>",
  "platformCommit": "disabled",
  "packageRules": [
    {
      "description": "Keep the go directive (which CI's setup-go builds with) on the latest patch release, so govulncheck sees the fixed standard library.",
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
